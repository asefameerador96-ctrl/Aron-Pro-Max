<?xml version="1.0" encoding="utf-8"?>
<!-- One adaptive icon for the three apps: the shared Aron logo (core-ui, D-BRAND-01) on this app's own plate colour
     (values/ic_launcher_background.xml). The round variant is identical; the launcher applies its own mask. The
     monochrome layer is the Android 13 themed icon; older systems ignore it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/aron_launcher_foreground" />
    <monochrome android:drawable="@mipmap/aron_launcher_monochrome" />
</adaptive-icon>
