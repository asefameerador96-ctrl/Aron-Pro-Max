<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only, no user-installed CAs, no pinning (docs/24 s5.8, D24-61). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
