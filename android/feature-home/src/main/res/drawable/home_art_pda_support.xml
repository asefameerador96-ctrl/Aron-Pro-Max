    android:viewportHeight="48">
    <!-- the round badge -->
    <path android:pathData="M24 2a22 22 0 1 0 .01 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24" android:startY="2" android:endX="24" android:endY="46"
                android:type="linear">
                <item android:offset="0" android:color="#FFE0536A" />
                <item android:offset="1" android:color="#FF2F7FD6" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- globe (upper left): outline, equator and meridian -->
    <path
        android:pathData="M16 15m-7 0a7 7 0 1 1 14 0a7 7 0 1 1-14 0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6" />
    <path
