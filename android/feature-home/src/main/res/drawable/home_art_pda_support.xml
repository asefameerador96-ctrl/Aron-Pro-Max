        android:pathData="M27 24h11a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5h-11a1.5 1.5 0 0 1-1.5-1.5v-7a1.5 1.5 0 0 1 1.5-1.5z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M32.5 34v3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M29 37h7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6" />
