<?xml version="1.0" encoding="utf-8"?>
<!-- android:dpc, reduced by D-OWNER-MDM-02: no device-owner enrolment, no policy, no app blocking. Only the empty admin
     receiver stays, for one release, so an upgraded phone that is still device owner can release it (D-AINT-01). It has
     no provisioning intent filter and is not an enrolment path. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.aktcl.aron.dpc.AronDeviceAdminReceiver"
            android:description="@string/aron_dpc_description"
            android:exported="true"
            android:label="@string/aron_dpc_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/aron_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
