<?xml version="1.0" encoding="utf-8"?>
<!-- android:core-geo: on-demand location fixes (docs/24 s5.5, s11.1), plus optional batched breadcrumbs (N-035).
     ACCESS_BACKGROUND_LOCATION is NOT declared: F-SYS-023 keeps location in-use only (ManifestPermissionAuditTest).
     Breadcrumbs therefore collect only while the app is in use, until the lead rules on
     docs/requests/android-geo-dpc-breadcrumb-background.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Mock-location app detection (FixDeviceState.mock_app_present, docs/24 s10.3); the apps ship outside Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <application>
        <!-- Batched breadcrumb deliveries from the fused provider through the app's own PendingIntent. -->
        <receiver
            android:name="com.aktcl.aron.core.geo.BreadcrumbReceiver"
            android:exported="false" />
    </application>
</manifest>
