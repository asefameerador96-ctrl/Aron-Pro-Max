# Copy to .env.local for development. Nothing here is a secret; real values come from Azure Key Vault / GitHub secrets.
# Base URL of the Aron API (origin only; paths already start with /v1). Defaults to the local mock server.
ARON_API_BASE_URL=http://127.0.0.1:4010
# 32+ random characters used to seal the BFF session cookies. REQUIRED in production (the server refuses to start without it).
ARON_SESSION_SECRET=
# Google Maps JavaScript API key (GitHub secret MAPS_WEB_KEY at build time). Empty = maps show a placeholder.
NEXT_PUBLIC_MAPS_WEB_KEY=
